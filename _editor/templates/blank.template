<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="" name="description"/>
<link href="/favicon-32.png" rel="icon" sizes="32x32" type="image/png"/><link href="/favicon.png" rel="icon" sizes="192x192" type="image/png"/><link href="/favicon.png" rel="apple-touch-icon"/>
<style>
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
img{max-width:100%}
[hidden]{display:none!important}
</style>
<title>New page | Michael Kinsey</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&amp;family=Geist+Mono:wght@400..500&amp;display=swap" rel="stylesheet"/>
<style>
/* Layout: tools landing page. A grid of 2:1 product tiles (logo top-left, image hidden until hover,
   descriptor bottom-right), then colour-block sections for mission, services and newsletter.
   Greyscale palette shared with the rest of the site; single dark theme by design. */
:root{
  color-scheme:dark;
  --bg:#000000; --panel:#333333; --panel-2:#3d3d3d; --ink:#f9f9f9; --muted:#a7a7a7; --line:#333333;
  --accent:#e85002; --accent-ink:#000000;
  --f-display:"Geist","Segoe UI",system-ui,sans-serif;
  --f-body:"Geist","Segoe UI",system-ui,sans-serif;
  --f-mono:"Geist Mono",ui-monospace,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font:16px/1.6 var(--f-body);-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.wrap{max-width:1280px;margin:0 auto}
.display{font-family:var(--f-display);font-weight:600;letter-spacing:-.035em;line-height:1.02}
.label{font:500 13px/1.3 var(--f-mono);letter-spacing:.01em;color:var(--muted)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;font:600 15px var(--f-body);text-decoration:none;border:1px solid var(--line);color:var(--ink);background:transparent;cursor:pointer}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* colour-block sections */
.t-black,.t-dark,.t-light,.t-white{background:var(--bg);color:var(--ink)}
.t-black{--bg:#000000;--panel:#333333;--ink:#f9f9f9;--muted:#a7a7a7;--line:#333333;--accent:#e85002;--accent-ink:#000000}
.t-dark{--bg:#333333;--panel:#3d3d3d;--ink:#f9f9f9;--muted:#a7a7a7;--line:#4d4d4d;--accent:#e85002;--accent-ink:#000000}
.t-light{--bg:#a7a7a7;--panel:#ececec;--ink:#000000;--muted:#333333;--line:#8a8a8a;--accent:#e85002;--accent-ink:#000000}
.t-white{--bg:#f9f9f9;--panel:#f0f0f0;--ink:#000000;--muted:#646464;--line:#a7a7a7;--accent:#e85002;--accent-ink:#000000}
section.block{padding-block:clamp(72px,10vw,128px)}

/* top bar */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:#000}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:rgba(0,0,0,.86);backdrop-filter:blur(10px);border-bottom:1px solid #333333}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.brand svg{height:22px;width:auto}
.brand span{font:700 15px var(--f-display);text-transform:uppercase;letter-spacing:.04em}
.top nav{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.top nav a{text-decoration:none;color:var(--muted);font-size:14px}
.top nav a:hover{color:var(--ink)}
.top .btn{padding:8px 16px;font-size:13px}

/* intro */
.intro{padding-block:clamp(56px,8vw,96px) 40px}
.intro h1{font-size:clamp(44px,7vw,92px);margin:10px 0 16px;max-width:14ch}
.intro p{color:var(--muted);font-size:clamp(17px,1.6vw,20px);max-width:52ch;margin:0}

/* product grid */
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding-bottom:clamp(72px,10vw,120px)}
.tile{position:relative;display:block;aspect-ratio:2/1;max-width:100%;border-radius:14px;overflow:hidden;background:#0d0d0d;text-decoration:none;isolation:isolate}
.tile .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.38);transform:scale(1.04);transition:filter .5s ease,transform .9s cubic-bezier(.2,.7,.2,1);z-index:0}
.tile::after{content:"";position:absolute;inset:0;z-index:1;opacity:0;transition:opacity .5s;
  background:linear-gradient(to top left,rgba(0,0,0,.78) 0%,rgba(0,0,0,.25) 38%,transparent 60%)}
.tile .logo{position:absolute;z-index:2;top:0;left:0;width:50%;height:auto;border-radius:0;transform-origin:0 0;transition:transform .6s cubic-bezier(.2,.7,.2,1),border-radius .6s}
.tile:hover .logo,.tile:focus-visible .logo,.tile.on .logo{transform:translate(16px,16px) scale(.22);border-radius:44px;background:rgba(0,0,0,.55)}
.tile .logo{filter:drop-shadow(0 2px 12px rgba(0,0,0,.5))}
.tile .mark{position:absolute;z-index:2;top:18px;left:20px;transform-origin:0 0;transform:translate(8px,22%) scale(2.1);transition:transform .6s cubic-bezier(.2,.7,.2,1);font:600 clamp(15px,1.4vw,18px)/1.15 var(--f-display);letter-spacing:-.01em;max-width:45%}
.tile .mark small{display:block;font:500 12px var(--f-mono);color:var(--muted);letter-spacing:.01em;margin-bottom:6px}
.tile .pill{position:absolute;z-index:2;top:18px;right:18px;font:500 12px var(--f-mono);padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.14)}
.tile .pill.free{background:#f9f9f9;color:#000;border-color:#f9f9f9}
.tile .desc{position:absolute;z-index:2;right:20px;bottom:18px;max-width:min(60%,380px);text-align:right;opacity:0;transform:translateY(8px);transition:opacity .4s ease .05s,transform .5s ease}
.tile .desc b{display:block;font:600 18px var(--f-display);letter-spacing:-.01em}
.tile .desc span{display:block;color:#a7a7a7;font-size:14px;line-height:1.45;margin-top:2px}
.tile .desc em{font-style:normal;display:inline-block;margin-top:8px;font:500 13px var(--f-mono);border-bottom:1px solid currentColor}
.tile:hover .bg,.tile:focus-visible .bg,.tile.on .bg{filter:brightness(1);transform:scale(1)}
.tile:hover::after,.tile:focus-visible::after,.tile.on::after{opacity:1}
.tile:hover .desc,.tile:focus-visible .desc,.tile.on .desc{opacity:1;transform:none}
.tile:hover .mark,.tile:focus-visible .mark,.tile.on .mark{transform:none}
.tile.soon .bg{background:repeating-linear-gradient(135deg,#2a2a2a 0 16px,#333 16px 32px)}
.tile.soon:hover .desc em,.tile.soon .desc em{border:0;color:var(--muted)}
.tile .ph{position:absolute;inset:0;display:grid;place-items:center;z-index:0;font:500 12px var(--f-mono);color:#555;opacity:0;transition:opacity .5s}
.tile:hover .ph{opacity:1}

/* mission */
.mission{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:56px;align-items:start}
.mission h2{font-size:clamp(40px,5.4vw,68px);margin:10px 0 0}
.mission p{font-size:18px;margin:0 0 16px;max-width:58ch}
.mission p.muted{color:var(--muted);font-size:16px}
.principles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:28px}
.principles div{background:#333333;color:#f9f9f9;border-radius:14px;padding:18px 20px;min-width:0}
.principles b{display:block;font:600 18px var(--f-display);letter-spacing:-.01em}
.principles span{color:#b3b3b3;font-size:14.5px}

/* services */
.head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:end;margin-bottom:36px}
.head h2{font-size:clamp(40px,5.4vw,68px);margin:8px 0 0}
.head p{margin:0;color:var(--muted);max-width:52ch}
.svc{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.svc div{background:var(--panel);border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:10px;min-width:0}
.svc h3{font:600 22px/1.15 var(--f-display);letter-spacing:-.02em;margin:0}
.svc p{margin:0;color:var(--muted);font-size:15px}
.contact{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:32px}
.contact code{font:500 16px var(--f-mono);background:var(--panel);padding:11px 16px;border-radius:999px;user-select:all;overflow-wrap:anywhere}

/* newsletter */
.news{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:end}
.news h2{font-size:clamp(40px,5.4vw,68px);margin:8px 0 0}
.news form{display:flex;gap:10px;flex-wrap:wrap}
.news input{flex:1 1 220px;min-width:0;background:var(--panel);border:1px solid var(--line);color:var(--ink);padding:13px 18px;border-radius:999px;font:15px var(--f-body)}
.news .msg{flex-basis:100%;color:var(--muted);font-size:14px}
.news p{color:var(--muted);margin:0 0 16px}

footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-block:28px 40px;color:var(--muted);font-size:13px}
footer a{text-decoration:none}footer a:hover{color:var(--ink)}
.toast{position:fixed;z-index:40;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);opacity:0;transition:.3s;background:#f9f9f9;color:#000;padding:10px 18px;border-radius:999px;font-weight:600;font-size:14px;pointer-events:none}
.toast.show{opacity:1;transform:translate(-50%,0)}

@media (max-width:900px){
  .grid,.mission,.head,.news{grid-template-columns:1fr}
  .svc{grid-template-columns:repeat(2,minmax(0,1fr))}
  .top nav .hide-sm{display:none}
}
@media (max-width:520px){.svc,.principles{grid-template-columns:1fr}.tile .desc span{display:none}}
@media (prefers-reduced-motion:reduce){.tile .bg,.tile .desc{transition:opacity .2s}html{scroll-behavior:auto}}
.t-grad{background:linear-gradient(120deg,#000000 0%,#000000 40%,#c10801 74%,#f16001 92%,#d9c3ab 125%)!important;color:#f9f9f9;
  --bg:transparent;--ink:#f9f9f9;--muted:#d9c3ab;--line:rgba(255,255,255,.2);--panel:rgba(0,0,0,.35);--panel-2:rgba(0,0,0,.25);--accent:#f9f9f9;--accent-ink:#000000;border-top:0!important}

/* services page */
.svc-hero .wrap{padding-block:clamp(72px,12vw,150px) clamp(64px,9vw,110px)}
.svc-hero h1{font-size:clamp(52px,9vw,120px);margin:14px 0 22px;max-width:14ch}
.svc-hero .pitch{font-size:clamp(18px,1.8vw,22px);color:var(--muted);max-width:52ch;margin:0 0 30px}
.ctas{display:flex;gap:12px;flex-wrap:wrap}
.offer{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.offer div{background:#333333;color:#f9f9f9;border-radius:14px;padding:26px 24px;display:flex;flex-direction:column;gap:10px;min-width:0}
.offer .n{font:500 13px var(--f-mono);color:var(--accent)}
.offer h3{font:600 22px/1.15 var(--f-display);letter-spacing:-.02em;margin:0}
.offer p{margin:0;color:#b3b3b3;font-size:15px}
.roles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:26px 0 34px}
.roles div{background:var(--panel);border-radius:14px;padding:16px 18px;min-width:0}
.roles b{display:block;font:600 16px var(--f-display)}
.roles span{color:var(--muted);font-size:14px}
.studio-row{display:flex;flex-wrap:wrap;align-items:center;gap:14px 18px}
.studio-row img{height:26px;width:auto;opacity:.75}
.studio-row img.wide{height:14px}
.steps3{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;counter-reset:s}
.steps3 li{background:var(--panel);border-radius:14px;padding:26px 24px;display:flex;flex-direction:column;gap:8px;counter-increment:s;min-width:0}
.steps3 li::before{content:counter(s,decimal-leading-zero);font:500 13px var(--f-mono);color:var(--accent)}
.steps3 b{font:600 22px/1.15 var(--f-display);letter-spacing:-.02em}
.steps3 span{color:var(--muted);font-size:15px}
#contact h2.big{font-size:clamp(56px,10vw,140px);margin:12px 0 28px}
#contact .else{display:flex;gap:22px;flex-wrap:wrap;margin-top:36px}
#contact .else a{color:var(--muted);text-decoration:none;border-bottom:1px solid var(--line);padding-bottom:2px}
#contact .else a:hover{color:var(--ink);border-color:var(--accent)}
@media (max-width:900px){.offer{grid-template-columns:repeat(2,minmax(0,1fr))}.steps3{grid-template-columns:1fr}}
@media (max-width:560px){.offer,.roles{grid-template-columns:1fr}}

/* top bar: full-width black, wordmark images */
.brand{display:flex!important;align-items:center;gap:12px;text-decoration:none}
.brand svg{height:24px!important;width:auto}
.brand .bn{height:16px;width:auto;display:block;max-width:none}
.brand .bd{width:1px;height:18px;background:rgba(255,255,255,.28)}
.brand .br{height:10px;width:auto;display:block;max-width:none;opacity:.8}
@media (max-width:560px){.brand .bd,.brand .br{display:none}}
.top{position:sticky!important;top:0!important;background:#000!important;backdrop-filter:none!important;border-bottom:1px solid #1f1f1f!important}

/* MK mark image */
.brand .mk{height:24px;width:auto;display:block;max-width:none}
.tilt img{width:min(52%,380px);height:auto;max-width:none;opacity:.18;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .15s ease-out, opacity .5s}
.col.fab.active .tilt img{opacity:.38}
footer .fl{display:inline-flex;align-items:center;gap:12px}
footer .fmk{height:22px;width:auto;display:block;opacity:.9}
</style>
</head>
