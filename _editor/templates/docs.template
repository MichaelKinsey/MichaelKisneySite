<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<link href="/favicon-32.png" rel="icon" sizes="32x32" type="image/png"/><link href="/favicon.png" rel="icon" sizes="192x192" type="image/png"/><link href="/favicon.png" rel="apple-touch-icon"/>
<title>New page | Michael Kinsey</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&amp;family=Geist+Mono:wght@400..500&amp;display=swap" rel="stylesheet"/>
<style>
/* Docs layout shared with the erosion docs: brand header, left page nav, reading column,
   filterable console-variable reference. Amber accent for SSDM+. Single dark theme. */
:root{
  color-scheme:dark;
  --bg:#000000; --panel:#333333; --ink:#f9f9f9; --muted:#a7a7a7; --line:#333333;
  --accent:#e85002; --accent-ink:#000000; --warn:#ff5a3c;
  --f-display:"Archivo","Arial Narrow","Helvetica Neue",Arial,sans-serif;
  --f-body:"Instrument Sans","Segoe UI",system-ui,sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.65 var(--f-body)}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.wrap{max-width:1180px;margin:0 auto}
.display{font-family:var(--f-display);font-stretch:68%;font-weight:850;text-transform:uppercase;line-height:.92}
.label{font:500 11.5px/1.3 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:rgba(0,0,0,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
.brand svg{height:22px;width:auto}
.brand span{font:800 15px var(--f-display);font-stretch:80%;text-transform:uppercase;letter-spacing:.04em}
.top nav{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.top nav a{text-decoration:none;color:var(--muted);font-size:14px}
.top nav a:hover,.top nav a[aria-current]{color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;font:600 13px var(--f-body);text-decoration:none;background:var(--accent);color:var(--accent-ink)!important}

.layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:48px;padding-block:40px 80px}
.side{position:sticky;top:calc(70px + env(safe-area-inset-top,0px));align-self:start;max-height:calc(100vh - 90px);overflow:auto}
.side ol{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:2px}
.side a{display:block;padding:6px 10px;border-left:2px solid transparent;color:var(--muted);text-decoration:none;font-size:14.5px}
.side a:hover{color:var(--ink)}
.side a.on{color:var(--ink);border-left-color:var(--accent)}

article{min-width:0;max-width:780px}
.intro h1{font-size:clamp(44px,6vw,72px);margin:10px 0 14px}
.intro p{color:var(--muted);font-size:18px;margin:0 0 8px;max-width:60ch}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 0}
.meta span{font:500 12px var(--f-mono);padding:5px 9px;border:1px solid var(--line);color:var(--muted)}
.meta span.no{border-color:var(--warn);color:var(--warn)}
section{padding-top:48px;scroll-margin-top:80px}
section h2{font-size:clamp(32px,4vw,44px);margin:0 0 16px;padding-top:28px;border-top:1px solid var(--line)}
section h3{font:600 18px var(--f-body);margin:28px 0 8px}
p{margin:0 0 14px}
ul.check{list-style:none;padding:0;margin:0;display:grid;gap:10px}
ul.check li{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;background:var(--panel);border:1px solid var(--line)}
ul.check li::before{content:"";flex:0 0 14px;height:14px;margin-top:5px;border:1.5px solid var(--accent)}
ul.check li.no::before{border-color:var(--warn);background:linear-gradient(45deg,transparent 45%,var(--warn) 45% 55%,transparent 55%)}
ol.steps{counter-reset:s;list-style:none;padding:0;margin:0}
ol.steps li{counter-increment:s;display:grid;grid-template-columns:44px minmax(0,1fr);gap:10px;padding:14px 0;border-bottom:1px solid var(--line)}
ol.steps li::before{content:counter(s,decimal-leading-zero);font:500 13px var(--f-mono);color:var(--accent);padding-top:2px}
code{font:500 .88em var(--f-mono);background:var(--panel);border:1px solid var(--line);padding:1px 6px;overflow-wrap:anywhere}
.path{font:500 13px var(--f-mono);color:var(--ink)}
.note{border:1px solid var(--line);border-left:3px solid var(--accent);background:var(--panel);padding:14px 16px;margin:16px 0}
.note.warn{border-left-color:var(--warn)}
.note b{display:block;font:500 11.5px var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:4px}
.note.warn b{color:var(--warn)}

.scroll{overflow-x:auto;border:1px solid var(--line)}
table{width:100%;border-collapse:collapse;font-size:14.5px}
th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}
th{font:500 11.5px var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:500;background:var(--panel)}
td.num{font-family:var(--f-mono);font-variant-numeric:tabular-nums;white-space:nowrap}
tr:last-child td{border-bottom:0}

.pin{display:grid;grid-template-columns:120px minmax(0,1fr);gap:16px;padding:12px 0;border-bottom:1px solid var(--line)}
.pin b{font:500 14px var(--f-mono)}

.filter{display:flex;gap:10px;align-items:center;margin:4px 0 14px;flex-wrap:wrap}
.filter input{flex:1 1 260px;min-width:0;background:var(--panel);border:1px solid var(--line);color:var(--ink);padding:11px 13px;font:15px var(--f-body)}
.filter span{color:var(--muted);font-size:13px}
.group{margin-top:26px}
.group h3{display:flex;justify-content:space-between;align-items:baseline;gap:12px;border-bottom:1px solid var(--accent);padding-bottom:6px;margin:0}
.cv{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 16px;padding:14px 0;border-bottom:1px solid var(--line)}
.cv code{background:none;border:0;padding:0;color:var(--ink);font-size:13.5px}
.cv .def{font:500 12.5px var(--f-mono);color:var(--accent);white-space:nowrap}
.cv p{grid-column:1/-1;margin:0;color:#a7a7a7;font-size:15px}
.empty{color:var(--muted);padding:14px 0}

footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-block:24px 40px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}
footer a{color:var(--muted)}

@media (max-width:900px){
  .layout{grid-template-columns:1fr;gap:20px}
  .side{position:static;max-height:none;border:1px solid var(--line);padding:12px}
  .side ol{grid-template-columns:repeat(2,minmax(0,1fr))}
  .pin{grid-template-columns:1fr;gap:2px}
  .top nav .hide-sm{display:none}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

/* --- clean modern layer: colour-block sections, Geist type, softer details --- */
:root{--f-display:"Geist","Segoe UI",system-ui,sans-serif;--f-body:"Geist","Segoe UI",system-ui,sans-serif;--f-mono:"Geist Mono",ui-monospace,Consolas,monospace}
body{font-family:var(--f-body);-webkit-font-smoothing:antialiased}
.display{font-family:var(--f-display)!important;font-stretch:normal!important;font-weight:600!important;text-transform:none!important;letter-spacing:-.035em!important;line-height:1.02!important}
.label{text-transform:none;letter-spacing:.01em;font-size:13px}
.btn{border-radius:999px}
.t-black,.t-dark,.t-light,.t-white{background:var(--bg);color:var(--ink);border-top:0!important}
.t-black{--bg:#000000;--panel:#333333;--panel-2:#3d3d3d;--ink:#f9f9f9;--muted:#a7a7a7;--line:#333333;--accent:#e85002;--accent-ink:#000000;--ph:#646464}
.t-dark{--bg:#333333;--panel:#3d3d3d;--panel-2:#333333;--ink:#f9f9f9;--muted:#a7a7a7;--line:#4d4d4d;--accent:#e85002;--accent-ink:#000000;--ph:#4d4d4d}
.t-light{--bg:#a7a7a7;--panel:#ececec;--panel-2:#e2e2e2;--ink:#000000;--muted:#333333;--line:#8a8a8a;--accent:#e85002;--accent-ink:#000000;--ph:#9e9e9e}
.t-white{--bg:#f9f9f9;--panel:#f0f0f0;--panel-2:#e8e8e8;--ink:#000000;--muted:#646464;--line:#a7a7a7;--accent:#e85002;--accent-ink:#000000;--ph:#8a8a8a}
.t-light .no,.t-white .no{color:#b3261e!important;border-color:#b3261e!important}
section.block{padding-block:clamp(72px,10vw,128px)}
.media,.ba,.banner img,.cta-logo,.card,.diagram,.mode,.rcol,.step{border-radius:14px}
.banner img,.cta-logo,.ba{overflow:hidden}
.modes,.steps{border-radius:14px;overflow:hidden}
.head h2{font-size:clamp(40px,5.4vw,68px)}
table{color:inherit;font:inherit}
.hl b{font-family:var(--f-display);font-stretch:normal;text-transform:none;font-weight:600;letter-spacing:-.02em;font-size:20px}
/* docs: black header band + off-white reading band */
.docs-hero{padding-block:clamp(48px,7vw,88px)}
.docs-hero .wrap{display:flex;gap:28px;align-items:center;flex-wrap:wrap}
.docs-hero .intro h1{margin:8px 0 12px}
.docs-hero .intro p{color:var(--muted)}
.docs-logo{width:96px;height:96px;border-radius:16px;flex:0 0 auto}
.layout section h2{border-top-color:var(--line)}
.t-white .note{background:var(--panel)}
.t-white .note.warn{border-left-color:#b3261e}.t-white .note.warn b{color:#b3261e}
.t-white ul.check li.no::before{border-color:#b3261e;background:linear-gradient(45deg,transparent 45%,#b3261e 45% 55%,transparent 55%)}
.t-white dl.ref dd,.t-white .cv p,.t-white .pin span{color:#4d4d4d}
.t-white .side a.on{border-left-color:var(--ink)}
.t-white .video{background:repeating-linear-gradient(135deg,var(--panel) 0 14px,var(--panel-2) 14px 28px);color:var(--muted)}
.t-white table,.t-white .scroll{border-radius:12px}
.t-white ul.check li{border-radius:10px}
.t-white .note{border-radius:0 10px 10px 0}
/* docs: alternate section bands, full width behind the sidebar */
.layout{padding-block:0!important}
.side{z-index:1;padding-top:40px}
@media (max-width:900px){.side{position:relative;margin-top:24px;padding-top:12px}}
.layout article>section{position:relative;padding-block:56px!important;background:var(--sbg);box-shadow:0 0 0 100vmax var(--sbg);clip-path:inset(0 -100vmax)}
.layout article>section:nth-of-type(odd){--sbg:#f9f9f9}
.layout article>section:nth-of-type(even){--sbg:#e4e4e4;--panel:#f2f2f2;--panel-2:#ebebeb;--line:#c8c8c8;--muted:#333333}
.layout article>section h2{border-top:0!important;padding-top:0!important}
.layout article>section:last-child{padding-bottom:88px!important}
/* docs: sidebar as its own clean panel */
.side{background:#ffffff;border-radius:16px;padding:18px 12px!important;box-shadow:0 1px 2px rgba(0,0,0,.06),0 8px 24px rgba(0,0,0,.06);top:calc(80px + env(safe-area-inset-top,0px))!important;margin-top:40px;max-height:calc(100vh - 110px)}
.side .label{display:block;padding:0 10px 6px;color:#646464}
.side ol{gap:2px!important}
.side a{border-left:0!important;border-radius:10px;padding:8px 10px!important;color:#333333!important}
.side a:hover{background:#f2f2f2;color:#000!important}
.side a.on{background:#e85002;color:#000!important}
@media (max-width:900px){.side{margin-top:24px;box-shadow:0 1px 2px rgba(0,0,0,.06);border:0}}
.t-grad{background:linear-gradient(120deg,#000000 0%,#000000 40%,#c10801 74%,#f16001 92%,#d9c3ab 125%)!important;color:#f9f9f9;
  --bg:transparent;--ink:#f9f9f9;--muted:#d9c3ab;--line:rgba(255,255,255,.2);--panel:rgba(0,0,0,.35);--panel-2:rgba(0,0,0,.25);--accent:#f9f9f9;--accent-ink:#000000;border-top:0!important}

/* top bar: full-width black, wordmark images */
.brand{display:flex!important;align-items:center;gap:12px;text-decoration:none}
.brand svg{height:24px!important;width:auto}
.brand .bn{height:16px;width:auto;display:block;max-width:none}
.brand .bd{width:1px;height:18px;background:rgba(255,255,255,.28)}
.brand .br{height:10px;width:auto;display:block;max-width:none;opacity:.8}
@media (max-width:560px){.brand .bd,.brand .br{display:none}}
.top{position:sticky!important;top:0!important;background:#000!important;backdrop-filter:none!important;border-bottom:1px solid #1f1f1f!important}

/* MK mark image */
.brand .mk{height:24px;width:auto;display:block;max-width:none}
.tilt img{width:min(52%,380px);height:auto;max-width:none;opacity:.18;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .15s ease-out, opacity .5s}
.col.fab.active .tilt img{opacity:.38}
footer .fl{display:inline-flex;align-items:center;gap:12px}
footer .fmk{height:22px;width:auto;display:block;opacity:.9}

.contact-list{list-style:none;margin:0 0 24px;padding:0;display:grid;gap:8px}
.contact-list li{display:flex;gap:16px;align-items:baseline;flex-wrap:wrap}
.contact-list b{min-width:70px;font-weight:600}
.contact-list a{color:var(--accent)}
</style>
</head>
