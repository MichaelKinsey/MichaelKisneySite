<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="" name="description"/>
<link href="/favicon-32.png" rel="icon" sizes="32x32" type="image/png"/><link href="/favicon.png" rel="icon" sizes="192x192" type="image/png"/><link href="/favicon.png" rel="apple-touch-icon"/>
<style>
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
img{max-width:100%}
[hidden]{display:none!important}

/* product facts in the Get SSDM+ section */
.badges{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
.badges span{font:500 12px var(--f-mono);letter-spacing:.06em;padding:6px 10px;border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.75);background:rgba(0,0,0,.35)}
.badges span.no{border-color:#ff5a3c;color:#ff5a3c}
.compat{display:flex;gap:10px;align-items:flex-start;max-width:52ch;margin:0 0 26px;padding:10px 12px;border-left:3px solid #ff5a3c;background:rgba(0,0,0,.45);font-size:14.5px;color:#fff}
.compat b{color:#ff5a3c;font:500 11.5px var(--f-mono);letter-spacing:.12em;white-space:nowrap;padding-top:2px}

/* mailing list band */
.news-band{padding-block:clamp(48px,7vw,80px);border-top:1px solid #1f1f1f}
.news-wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,72px);align-items:center}
.news-band h2{font-size:clamp(26px,3vw,38px);line-height:1.1;margin:12px 0 10px}
.news-band p{margin:0;color:var(--muted)}
.news-band .soon-badge{margin-left:8px}
.news-band .news{margin-top:0}
.news-band .news input{max-width:none}
.news-band .msg a{color:inherit}
@media (max-width:860px){.news-wrap{grid-template-columns:1fr}}
</style>
<title>New page | Michael Kinsey</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&amp;family=Geist+Mono:wght@400..500&amp;display=swap" rel="stylesheet"/>
<style>
/* Layout: product promo template. Black-and-white Michael Kinsey brand (heavy condensed caps, logo mark),
   one amber accent for SSDM+. Product thumbnail in the hero; placeholders double as the capture shot list.
   Deliberately single dark theme: the brand is white on black. */
:root{
  color-scheme:dark;
  --bg:#000000; --panel:#333333; --panel-2:#3d3d3d; --ink:#f9f9f9; --muted:#a7a7a7; --line:#333333;
  --accent:#e85002; --accent-ink:#000000; --ph:#646464;
  --f-display:"Archivo","Arial Narrow","Helvetica Neue",Arial,sans-serif;
  --f-body:"Instrument Sans","Segoe UI",system-ui,sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font:16px/1.6 var(--f-body)}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.wrap{max-width:1200px;margin:0 auto}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.display{font-family:var(--f-display);font-stretch:68%;font-weight:850;text-transform:uppercase;letter-spacing:.005em;line-height:.9}
.label{font:500 11.5px/1.2 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.btn{display:inline-flex;align-items:center;gap:10px;padding:13px 20px;font:600 15px var(--f-body);text-decoration:none;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn:hover{border-color:var(--ink)}
.btn.primary:hover{filter:brightness(1.08)}

/* top bar */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:rgba(0,0,0,.86);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.brand svg{height:26px;width:auto}
.brand span{font:800 15px var(--f-display);font-stretch:80%;text-transform:uppercase;letter-spacing:.04em}
.top nav{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.top nav a{text-decoration:none;color:var(--muted);font-size:14px}
.top nav a:hover{color:var(--ink)}
.top .btn{padding:8px 14px;font-size:13px}

/* draft ribbon */
.draft{background:var(--panel);border-bottom:1px solid var(--line)}
.draft .wrap{padding-block:8px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.draft b{color:var(--accent);font:500 11.5px var(--f-mono);letter-spacing:.12em}
.draft span{color:var(--muted);font-size:13px}

/* hero */
.hero .wrap{padding-block:28px 56px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.banner{margin:0 0 32px}
.banner img{display:block;width:100%;height:auto;max-width:100%;border:1px solid var(--line)}
.hero-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:start}
.hero-row .mini{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.mini-logo{width:56px;height:56px;border-radius:12px;flex:0 0 auto}
.hero-row .badges{margin-bottom:16px}
.hero-row .compat{margin:0}
.pitch{font-size:clamp(20px,2.2vw,26px);line-height:1.35;max-width:30ch;margin:0 0 22px;text-wrap:balance}
.badges{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.badges span{font:500 12px var(--f-mono);letter-spacing:.06em;padding:6px 10px;border:1px solid var(--line);color:var(--muted)}
.badges span.tbd{border-style:dashed}
.badges span.no{border-color:#ff5a3c;color:#ff5a3c}
.compat{display:flex;gap:10px;align-items:flex-start;max-width:52ch;margin:-8px 0 22px;padding:10px 12px;border-left:3px solid #ff5a3c;background:var(--panel);font-size:14.5px}
.compat b{color:#ff5a3c;font:500 11.5px var(--f-mono);letter-spacing:.12em;white-space:nowrap;padding-top:2px}
.tbl td.no{color:#ff5a3c}
.ctas{display:flex;gap:12px;flex-wrap:wrap}
.no-nanite{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;margin:18px 0 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.1);font-size:14px;line-height:1.4;color:rgba(255,255,255,.72)}
.no-nanite .label{color:#e85002;border:1px solid rgba(232,80,2,.7);border-radius:6px;padding:4px 8px;white-space:nowrap}

/* section heads */
section.block{padding-block:72px;border-top:1px solid var(--line)}
.head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:end;margin-bottom:36px}
.head h2{font-size:clamp(44px,6vw,76px);margin:8px 0 0}
.head p{margin:0;color:var(--muted);max-width:52ch}

/* before / after */
.ba{position:relative;aspect-ratio:2560/1360;max-width:100%;background:#000;overflow:hidden;touch-action:pan-y;user-select:none}
.ba .shot-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.ba .shot{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:22px 24px;
  background:repeating-linear-gradient(135deg,var(--panel) 0 14px,var(--panel-2) 14px 28px)}
.ba .shot.on{align-items:flex-end;text-align:right;background:repeating-linear-gradient(135deg,#333333 0 14px,#3d3d3d 14px 28px)}
.ba .shot b{font:500 11.5px var(--f-mono);letter-spacing:.12em;color:var(--accent)}
.ba .shot span{font-size:14px;max-width:34ch}
.ba #baOn{clip-path:inset(0 0 0 var(--split,50%))}
.ba .divider{position:absolute;top:0;bottom:0;left:var(--split,50%);width:2px;background:var(--accent);transform:translateX(-1px);pointer-events:none}
.ba .divider::after{content:"⟷";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:40px;height:40px;display:grid;place-items:center;background:var(--accent);color:var(--accent-ink);font-weight:700;border-radius:50%}
.ba .tag{position:absolute;top:14px;padding:5px 9px;background:rgba(0,0,0,.65);font:500 11.5px var(--f-mono);letter-spacing:.1em}
.ba .tag.l{left:14px}.ba .tag.r{right:14px;color:var(--accent)}
.ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
.under{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:12px}

/* strengths */
.feat{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center;padding-block:28px}
.feat:nth-child(even) .media{order:2}
.feat h3{font-size:clamp(34px,4.2vw,52px);margin:10px 0 14px}
.feat p{color:var(--muted);margin:0;max-width:46ch}
.media{aspect-ratio:16/9;max-width:100%;border:1px dashed var(--ph);display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:16px;
  background:repeating-linear-gradient(135deg,var(--panel) 0 14px,var(--panel-2) 14px 28px)}
.media b{font:500 11.5px var(--f-mono);letter-spacing:.12em;color:var(--accent)}
.media span{font-size:14px;color:var(--ink);max-width:42ch}

/* modes */
.modes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
.mode{background:var(--bg);padding:26px;display:flex;flex-direction:column;gap:10px;min-width:0}
.mode h3{font-size:34px;margin:0}
.mode p{margin:0;color:var(--muted);font-size:15px}
.mode .sw{display:flex;gap:6px}
.mode .sw i{width:30px;height:6px;background:var(--line)}
.mode .sw i.on{background:var(--accent)}

/* diagram */
.diagram{overflow-x:auto;border:1px solid var(--line);background:var(--panel);padding:20px}
.diagram svg{display:block;min-width:760px;width:100%;height:auto}
.diagram .box{fill:var(--bg);stroke:var(--line)}
.diagram .box.hl{stroke:var(--accent)}
.diagram text{fill:var(--ink);font-family:var(--f-body);font-size:14px}
.diagram .t{font-family:var(--f-display);font-weight:800;font-stretch:75%;font-size:19px;text-transform:uppercase}
.diagram .s{fill:var(--muted);font-family:var(--f-mono);font-size:11.5px}
.diagram .arrow{stroke:var(--muted);stroke-width:1.5;fill:none}
.diagram .arrow.hl{stroke:var(--accent)}

/* proof + specs */
.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px}
.tbl{width:100%;border-collapse:collapse;font-size:15px}
.tbl th,.tbl td{text-align:left;padding:12px 10px;border-bottom:1px solid var(--line);vertical-align:top}
.tbl th{font:500 11.5px var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:500}
.tbl td.num{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.tbl .tbd{color:var(--muted);border:1px dashed var(--ph);padding:1px 6px;font-family:var(--f-mono);font-size:12px}
.tbl .yes{color:var(--accent)}
.scroll{overflow-x:auto}
.card{border:1px solid var(--line);padding:24px;min-width:0}
.card h3{font-size:30px;margin:0 0 6px}
.card .label{margin-bottom:16px;display:block}

/* faq */
.faq{display:grid;gap:0;border-top:1px solid var(--line)}
.faq details{border-bottom:1px solid var(--line);padding-block:18px}
.faq summary{cursor:pointer;font-weight:600;font-size:17px;list-style:none;display:flex;justify-content:space-between;gap:16px}
.faq summary::after{content:"+";color:var(--accent);font-family:var(--f-mono)}
.faq details[open] summary::after{content:"−"}
.faq p{color:var(--muted);margin:10px 0 0;max-width:70ch}

/* cta */
.cta{text-align:left}
.cta{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,320px);gap:48px;align-items:center}
.cta-text{min-width:0}
.cta-logo{display:block;width:100%;height:auto;max-width:320px;justify-self:end;border:1px solid var(--line)}
.cta h2{font-size:clamp(56px,9vw,128px);margin:0 0 24px}
.news{display:flex;gap:10px;flex-wrap:wrap;margin-top:36px;align-items:center}
.news input{background:var(--panel);border:1px solid var(--line);color:var(--ink);padding:12px 14px;font:15px var(--f-body);min-width:0;flex:1 1 240px;max-width:360px}
.news .msg{color:var(--muted);font-size:14px;flex-basis:100%}

footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-block:28px 40px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}

@media (max-width:860px){
  .hero .wrap,.head,.feat,.two,.hero-row,.cta{grid-template-columns:1fr}
  .cta-logo{justify-self:start;max-width:200px;order:-1}
  .hero-row{gap:20px}
  .banner{margin-bottom:20px}
    .feat:nth-child(even) .media{order:0}
  .modes{grid-template-columns:1fr}
  .top nav a.hide-sm{display:none}
  .ba{aspect-ratio:4/3}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

/* --- clean modern layer: colour-block sections, Geist type, softer details --- */
:root{--f-display:"Geist","Segoe UI",system-ui,sans-serif;--f-body:"Geist","Segoe UI",system-ui,sans-serif;--f-mono:"Geist Mono",ui-monospace,Consolas,monospace}
body{font-family:var(--f-body);-webkit-font-smoothing:antialiased}
.display{font-family:var(--f-display)!important;font-stretch:normal!important;font-weight:600!important;text-transform:none!important;letter-spacing:-.035em!important;line-height:1.02!important}
.label{text-transform:none;letter-spacing:.01em;font-size:13px}
.btn{border-radius:999px}
.t-black,.t-dark,.t-light,.t-white{background:var(--bg);color:var(--ink);border-top:0!important}
.t-black{--bg:#000000;--panel:#333333;--panel-2:#3d3d3d;--ink:#f9f9f9;--muted:#a7a7a7;--line:#333333;--accent:#e85002;--accent-ink:#000000;--ph:#646464}
.t-dark{--bg:#333333;--panel:#3d3d3d;--panel-2:#333333;--ink:#f9f9f9;--muted:#a7a7a7;--line:#4d4d4d;--accent:#e85002;--accent-ink:#000000;--ph:#4d4d4d}
.t-light{--bg:#a7a7a7;--panel:#ececec;--panel-2:#e2e2e2;--ink:#000000;--muted:#333333;--line:#8a8a8a;--accent:#e85002;--accent-ink:#000000;--ph:#9e9e9e}
.t-white{--bg:#f9f9f9;--panel:#f0f0f0;--panel-2:#e8e8e8;--ink:#000000;--muted:#646464;--line:#a7a7a7;--accent:#e85002;--accent-ink:#000000;--ph:#8a8a8a}
.t-light .no,.t-white .no{color:#b3261e!important;border-color:#b3261e!important}
section.block{padding-block:clamp(72px,10vw,128px)}
.media,.ba,.banner img,.cta-logo,.card,.diagram,.mode,.rcol,.step{border-radius:14px}
.banner img,.cta-logo,.ba{overflow:hidden}
.modes,.steps{border-radius:14px;overflow:hidden}
.head h2{font-size:clamp(40px,5.4vw,68px)}
/* dark cards, no outlines */
.modes,.steps{background:none!important;border:0!important;gap:16px!important;border-radius:0!important;overflow:visible!important}
.mode,.step{background:#333333!important;color:#f9f9f9;border:0!important}
.mode p,.step p{color:#b3b3b3!important}
.mode .sw i{background:#444!important}.mode .sw i.on{background:#f9f9f9!important}
.step::before{color:#f9f9f9!important}
table{color:inherit;font:inherit}
.hl b{font-family:var(--f-display);font-stretch:normal;text-transform:none;font-weight:600;letter-spacing:-.02em;font-size:20px}
.t-grad{background:linear-gradient(120deg,#000000 0%,#000000 40%,#c10801 74%,#f16001 92%,#d9c3ab 125%)!important;color:#f9f9f9;
  --bg:transparent;--ink:#f9f9f9;--muted:#d9c3ab;--line:rgba(255,255,255,.2);--panel:rgba(0,0,0,.35);--panel-2:rgba(0,0,0,.25);--accent:#f9f9f9;--accent-ink:#000000;border-top:0!important}

/* newsletter: coming soon */
.soon-badge{display:inline-block;margin-left:10px;font:600 11px var(--f-mono);font-style:normal;letter-spacing:.06em;text-transform:uppercase;color:#000;background:#e85002;padding:3px 8px;border-radius:999px;vertical-align:1px}
#newsForm input:disabled,#newsForm button:disabled{opacity:.5;cursor:not-allowed}

/* top bar: full-width black, wordmark images */
.brand{display:flex!important;align-items:center;gap:12px;text-decoration:none}
.brand svg{height:24px!important;width:auto}
.brand .bn{height:16px;width:auto;display:block;max-width:none}
.brand .bd{width:1px;height:18px;background:rgba(255,255,255,.28)}
.brand .br{height:10px;width:auto;display:block;max-width:none;opacity:.8}
@media (max-width:560px){.brand .bd,.brand .br{display:none}}
@media (max-width:560px){.top nav{flex-wrap:nowrap;gap:12px}.top nav a[href="docs/"]{display:none}.top .btn{white-space:nowrap;padding:7px 12px;font-size:12px}.brand .bn{height:13px;width:auto}}
.top{position:sticky!important;top:0!important;background:#000!important;backdrop-filter:none!important;border-bottom:1px solid #1f1f1f!important}

/* MK mark image */
.brand .mk{height:24px;width:auto;display:block;max-width:none}
.tilt img{width:min(52%,380px);height:auto;max-width:none;opacity:.18;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .15s ease-out, opacity .5s}
.col.fab.active .tilt img{opacity:.38}
footer .fl{display:inline-flex;align-items:center;gap:12px}
footer .fmk{height:22px;width:auto;display:block;opacity:.9}

/* pricing */
.prices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:520px;margin:0 0 24px}
.prices div{background:rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:16px 18px;display:flex;flex-direction:column;gap:4px;min-width:0}
.prices b{font:600 30px/1.1 var(--f-display);letter-spacing:-.02em}
.prices small{color:var(--muted);font-size:13px}
.tbl td b{font-weight:600}
@media (max-width:420px){.prices{grid-template-columns:1fr}}

.card .note{margin:16px 0 0;color:var(--muted);font-size:14px;line-height:1.5}

.media.vid{padding:0;border:0;background:#000;overflow:hidden}
.media.vid video{width:100%;height:100%;object-fit:cover;display:block}

.btn.pending{cursor:default}
.btn.pending::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;opacity:.75;animation:pend 1.6s ease-in-out infinite}
@keyframes pend{50%{opacity:.25}}
@media (prefers-reduced-motion:reduce){.btn.pending::before{animation:none}}

/* hero: full-bleed walkthrough video with a darkened details area */
.hero.has-vid{position:relative;overflow:hidden;min-height:calc(100svh - 48px);display:flex;align-items:flex-end;isolation:isolate}
.hero.has-vid .wrap{position:relative;z-index:2;width:100%;padding-block:clamp(120px,30vh,320px) clamp(40px,6vh,64px)}
.hero-vid{position:absolute;inset:0;z-index:0;background:#000}
.hero-vid video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0}
.hero-vid video.on{opacity:1}
.hero-vid::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.25) 0%,rgba(0,0,0,.1) 30%,rgba(0,0,0,.55) 60%,rgba(0,0,0,.88) 100%)}
.hero.has-vid .hero-row{background:rgba(0,0,0,.45);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:clamp(20px,3vw,36px)}
.hero.has-vid .badges span{background:rgba(0,0,0,.35)}
@media (max-width:860px){.hero.has-vid{min-height:auto}.hero.has-vid .wrap{padding-top:clamp(180px,45vw,320px)}}

/* quick intro band under the hero */
.intro-band .wrap{padding-block:clamp(36px,5vw,56px)}
.why{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,4vw,56px)}
.why .label{color:var(--accent);font-size:13px}
.why p{margin:8px 0 0;font-size:clamp(17px,1.6vw,20px);line-height:1.45;max-width:46ch}
@media (max-width:720px){.why{grid-template-columns:1fr}}

/* compare labels readable on light sections */
.ba .tag{color:#fff!important;background:rgba(0,0,0,.72)!important;font-weight:600}
.ba .tag.r{color:#ff7a33!important}

/* feedback pass: simpler hero, solo section heads, clearer compare handle */
.hero.has-vid .hero-row{grid-template-columns:1fr;max-width:560px}
.hero.has-vid .pitch{margin-bottom:22px}
.head.solo{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}
.head.solo p{max-width:52ch}
.head.solo > a{color:var(--accent);text-decoration:none;font-weight:600}
