<script>


/* before / after */
const ba=document.getElementById('ba'),range=document.getElementById('baRange');
range.addEventListener('input',()=>ba.style.setProperty('--split',range.value+'%'));

/* newsletter (draft) */
document.getElementById('newsForm').addEventListener('submit',e=>{e.preventDefault();document.getElementById('newsMsg').hidden=false});

/* feature clips: play while on screen */
{const vs=document.querySelectorAll('.media.vid video');
 if(vs.length&&!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver' in window){
  const io=new IntersectionObserver(es=>es.forEach(e=>{const v=e.target;if(e.isIntersecting){v.preload='auto';v.play().catch(()=>{})}else v.pause()}),{threshold:.35});
  vs.forEach(v=>io.observe(v))}}

/* hero walkthrough: three 8 s parts played back to back, looping */
{const vs=[...document.querySelectorAll('.hero-vid video')];let i=0;
 const still=matchMedia('(prefers-reduced-motion: reduce)').matches;
 if(still){vs[0].removeAttribute('autoplay');vs[0].pause()}
 else{
  const play=v=>{const p=v.play();if(p&&p.catch)p.catch(()=>{})};
  vs[0].addEventListener('playing',()=>{vs[1].preload='auto'},{once:true});
  vs.forEach((v,k)=>v.addEventListener('ended',()=>{const n=(k+1)%vs.length,nv=vs[n];nv.currentTime=0;play(nv);nv.classList.add('on');v.classList.remove('on');i=n;
    const nn=vs[(n+1)%vs.length];nn.preload='auto'}));
  document.addEventListener('visibilitychange',()=>{document.hidden?vs[i].pause():play(vs[i])});
  play(vs[0]);
 }}

/* compare: hint sweep on first view */
{const ba=document.getElementById('ba'),r=document.getElementById('baRange');let used=false;
 const mark=()=>{used=true;ba.classList.add('used')};['pointerdown','touchstart','keydown'].forEach(e=>r.addEventListener(e,mark));
 if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver' in window){
  const io=new IntersectionObserver(es=>{if(!es[0].isIntersecting||used)return;io.disconnect();
    const t0=performance.now(),D=2400;const step=t=>{if(used)return;const k=Math.min(1,(t-t0)/D);const v=50+Math.sin(k*Math.PI*2)*22;
      r.value=v;ba.style.setProperty('--split',v+'%');if(k<1)requestAnimationFrame(step)};setTimeout(()=>requestAnimationFrame(step),400)},{threshold:.5});
  io.observe(ba)}}
</script>
